# 开发镜像：只跑后端（前端用宿主机 pnpm dev，HMR 更快）
# 后端依赖 @devloop/server 的 pg 客户端；dev 走 bind mount，node_modules 来自宿主机，
# 因此 entrypoint 会在缺失时补装一次。
FROM node:24-alpine

# bootstrap 与任务执行都要 git
RUN apk add --no-cache git

WORKDIR /app

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

ENV NODE_ENV=development \
    DEVLOOP_HOST=0.0.0.0 \
    DEVLOOP_PORT=8787 \
    DATABASE_URL=postgres://devloop:devloop@postgres:5432/devloop

EXPOSE 8787

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["node", "--watch", "server/index.mjs"]
